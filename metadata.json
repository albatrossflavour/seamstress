{
  "name": "albatrossflavour-strings_site",
  "version": "0.1.0",
  "author": "albatrossflavour",
  "summary": "Builds and serves a searchable puppet-strings site for every module in every environment of a control repo.",
  "license": "Apache-2.0",
  "source": "https://github.com/albatrossflavour/strings_site",
  "project_page": "https://github.com/albatrossflavour/strings_site",
  "issues_url": "https://github.com/albatrossflavour/strings_site/issues",
  "dependencies": [
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.0.0 < 11.0.0"
    },
    {
      "name": "puppet/systemd",
      "version_requirement": ">= 8.0.0 < 12.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": ["9", "10"]
    },
    {
      "operatingsystem": "Rocky",
      "operatingsystemrelease": ["9", "10"]
    },
    {
      "operatingsystem": "AlmaLinux",
      "operatingsystemrelease": ["9", "10"]
    },
    {
      "operatingsystem": "OracleLinux",
      "operatingsystemrelease": ["9", "10"]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": ["22.04", "24.04"]
    }
  ],
  "requirements": [
    {
      "name": "puppet",
      "version_requirement": ">= 8.0.0 < 10.0.0"
    }
  ],
  "tags": ["puppet-strings", "documentation", "r10k", "control-repo", "yard"]
}
