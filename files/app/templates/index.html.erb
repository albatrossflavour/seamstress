<%- live = envs.select { |_, e| e['build'] } -%>
<div class="site-page">
  <header class="doc-head">
    <h1 class="site-title"><%= h.esc(config['site_title']) %></h1>
    <%- if live.empty? -%>
    <p class="lead">No documentation yet. The site fills in once the first environment builds; check the service log if this persists.</p>
    <%- else -%>
    <p class="lead">Reference documentation for <%= live.size == 1 ? 'one environment' : "#{live.size} environments" %>, built from <%= status['source'] == 'git' ? 'the control repo' : 'deployed code' %>.</p>
    <%- end -%>
  </header>

  <%- unless live.empty? -%>
  <button class="search-hero" type="button" data-palette-open aria-haspopup="dialog">
    <span>Search <%= h.esc(search_env) %> for a class, type, function, task, plan, or parameter</span><kbd>/</kbd>
  </button>
  <%- end -%>

  <section class="envs" aria-labelledby="envs-heading">
    <h2 id="envs-heading">Environments</h2>
    <%- if envs.empty? -%>
    <p class="muted">No environments matched the configured filters.</p>
    <%- end -%>
    <ul class="env-list">
      <%- envs.each do |name, e| -%>
      <%- prov = e['provenance'] || {} -%>
      <%- attempt = e['last_attempt'] || {} -%>
      <%- stale = attempt['status'] == 'failed' -%>
      <%- cmp = compare[name] -%>
      <li class="env<%= stale ? ' env-stale' : '' %>">
        <div class="env-head">
          <%- if e['build'] -%>
          <a class="env-name" href="environments/<%= h.esc(name) %>/index.html"><%= h.esc(name) %></a>
          <%- else -%>
          <span class="env-name"><%= h.esc(name) %></span>
          <%- end -%>
          <%= h.sha_html(prov['commit']) %>
        </div>
        <dl class="env-facts">
          <%- if e['build'] -%>
          <div><dt>Modules</dt><dd><%= e['modules'] %></dd></div>
          <div><dt>Built</dt><dd><time datetime="<%= h.esc(e['built_at']) %>"><%= h.time(e['built_at']) %></time></dd></div>
          <%- unless e['failed_modules'].empty? -%>
          <div class="warn"><dt>Docs failed</dt><dd><%= h.esc(e['failed_modules'].join(', ')) %></dd></div>
          <%- end -%>
          <%- end -%>
        </dl>
        <%- if stale -%>
        <p class="notice notice-failed">
          The build at <%= h.time(attempt['at']) %><%= attempt['commit'] ? " for #{h.esc(h.short(attempt['commit']))}" : '' %> failed: <%= h.esc(attempt['error']) %>.
          <%= e['build'] ? 'The previous good build is still being served.' : 'There is no earlier build to serve.' %>
        </p>
        <%- end -%>
      </li>
      <%- end -%>
    </ul>
    <%- if compare.size > 1 -%>
    <p><a href="compare.html">Compare the modules in two environments</a></p>
    <%- end -%>
  </section>
</div>
