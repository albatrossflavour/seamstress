<%= h.page('head', title: config['site_title'], root: root) %>
<body data-root="" data-page="index">
<%= h.page('masthead', root: root, crumb: nil) %>
<main class="sheet">
  <%- live = envs.select { |_, e| e['build'] } -%>
  <%- if live.empty? -%>
  <section class="empty">
    <h1>No documentation yet</h1>
    <p>The first build has not finished. The site fills in once an environment builds; check the service log if this persists.</p>
  </section>
  <%- else -%>
  <%= h.page('search', search_root: 'environments/', envs: live.map(&:first)) %>
  <%- end -%>

  <section class="envs" aria-labelledby="envs-heading">
    <h2 id="envs-heading">Environments</h2>
    <%- if envs.empty? -%>
    <p class="muted">No environments matched the configured filters.</p>
    <%- end -%>
    <ul class="env-list">
      <%- envs.each do |name, e| -%>
      <%- prov = e['provenance'] || {} -%>
      <%- attempt = e['last_attempt'] || {} -%>
      <%- stale = attempt['status'] == 'failed' -%>
      <li class="env<%= stale ? ' env-stale' : '' %>">
        <div class="env-head">
          <%- if e['build'] -%>
          <a class="env-name" href="environments/<%= h.esc(name) %>/index.html"><%= h.esc(name) %></a>
          <%- else -%>
          <span class="env-name"><%= h.esc(name) %></span>
          <%- end -%>
          <%- if prov['commit'] -%>
          <span class="sha"><i class="swatch" style="--swatch: <%= h.swatch(prov['commit']) %>"></i><code><%= h.short(prov['commit']) %></code></span>
          <%- end -%>
        </div>
        <dl class="env-facts">
          <%- if e['build'] -%>
          <div><dt>Modules</dt><dd><%= e['modules'] %></dd></div>
          <div><dt>Built</dt><dd><time datetime="<%= h.esc(e['built_at']) %>"><%= h.time(e['built_at']) %></time></dd></div>
          <%- unless e['failed_modules'].empty? -%>
          <div class="warn"><dt>Docs failed</dt><dd><%= h.esc(e['failed_modules'].join(', ')) %></dd></div>
          <%- end -%>
          <%- end -%>
        </dl>
        <%- if stale -%>
        <p class="notice notice-failed">
          The build at <%= h.time(attempt['at']) %><%= attempt['commit'] ? " for #{h.short(attempt['commit'])}" : '' %> failed: <%= h.esc(attempt['error']) %>.
          <%= e['build'] ? 'The previous good build is still being served.' : 'There is no earlier build to serve.' %>
        </p>
        <%- end -%>
      </li>
      <%- end -%>
    </ul>
  </section>
</main>
<footer class="provenance">
  <p>Page written <time datetime="<%= h.esc(status['generated_at']) %>"><%= h.time(status['generated_at']) %></time>.
  Last successful run <%= status['last_success'] ? h.time(status['last_success']) : 'not yet' %>.
  Generated by strings_site <%= StringsSite::VERSION %> from <%= status['source'] == 'git' ? 'the control repo' : 'deployed code' %>.</p>
</footer>
</body>
</html>
