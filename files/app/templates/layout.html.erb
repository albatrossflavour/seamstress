<%-
  env_name = site ? nil : manifest['environment']
  search_base = site ? (search_env ? "environments/#{search_env}/" : '') : env_root
  # The Hiera Explorer is a section of its own: full width, with no module
  # tree beside it and none of the module documentation's search or compare.
  explorer = name == 'hiera'
  # Site pages belong to no environment, so they start on the first one built
  # and the script moves them to the reader's last choice.
  chosen = site ? search_env : env_name
  chosen_root = site ? "environments/#{chosen}/" : env_root
  any_hiera = site ? !hiera.empty? : !manifest['hiera'].nil?
  search_name = site || explorer ? nil : env_name
  built = site ? '' : manifest['built_at']
-%>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="seamstress <%= Seamstress::VERSION %>">
<meta name="color-scheme" content="light dark">
<title><%= h.esc([title, env_name, config['site_title']].compact.uniq.join(' | ')) %></title>
<link rel="stylesheet" href="<%= root %>assets/site.css">
<script src="<%= root %>assets/site.js"></script>
<%- if name == 'hiera' -%>
<script src="<%= root %>assets/hiera.js"></script>
<%- end -%>
</head>
<body data-page="<%= name %>" data-root="<%= root %>"<%- if env_name -%> data-env="<%= h.esc(env_name) %>" data-built="<%= h.esc(built) %>"<%- end -%><%- if search_name -%> data-search-base="<%= h.esc(search_base) %>" data-search-env="<%= h.esc(search_name) %>"<%- end -%><%- if site -%> data-hiera-envs="<%= h.esc(hiera.keys.join(' ')) %>"<%- end -%>>
<a class="skip" href="#main">Skip to content</a>
<header class="topbar">
  <%- unless site || explorer -%>
  <button class="menu-toggle" type="button" data-menu-toggle aria-controls="sidebar" aria-expanded="false">Contents</button>
  <%- end -%>
  <a class="brand" href="<%= root %>index.html" title="<%= h.esc(config['site_title']) %>">
    <svg class="brand-mark" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true">
      <path class="brand-thread" d="M17.8 6.2c4.4-3.6 5 3.6-.9 5.3-3.3 1-7.9 1.4-9.4 3.7-1.1 1.7-.3 3.4 1 4.3"/>
      <path class="brand-needle" d="M3.5 20.5 16.4 7.6"/>
      <ellipse class="brand-eye" cx="17.6" cy="6.4" rx="1.5" ry="2.6" transform="rotate(45 17.6 6.4)"/>
    </svg>
    <span class="brand-name">seamstress</span>
  </a>
  <%- if chosen -%>
  <a class="env-pill" href="<%= chosen_root %>index.html" title="Environment"<%= ' data-env-choice' if site %>><%= h.esc(chosen) %></a>
  <nav class="sections" aria-label="Sections">
    <a href="<%= chosen_root %>index.html" data-env-path="index.html"<%= ' aria-current="true"' unless site || explorer %>>Module documentation</a>
    <%- if any_hiera -%>
    <a href="<%= chosen_root %>hiera.html" data-env-path="hiera.html" data-env-hiera<%= ' aria-current="true"' if explorer %><%= ' hidden' if site && !hiera[chosen] %>>Hiera Explorer</a>
    <%- end -%>
  </nav>
  <%- end -%>
  <%- if search_name -%>
  <button class="search-trigger" type="button" data-palette-open aria-haspopup="dialog">
    <span>Search<span class="search-scope"> <%= h.esc(search_name) %></span></span><kbd>/</kbd>
  </button>
  <%- end -%>
  <%- unless explorer || name == 'index' -%>
  <a class="topbar-link" href="<%= root %>compare.html">Compare</a>
  <%- end -%>
  <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch colour theme">Theme: auto</button>
</header>
<div class="banner" data-stale-banner role="status" hidden></div>
<div class="frame<%= site || explorer ? ' frame-site' : '' %>">
  <%- unless site || explorer -%>
  <%= h.page('sidebar', env: env, manifest: manifest, mod: mod, obj: obj, depth: depth, env_root: env_root, root: root) %>
  <%- end -%>
  <main id="main" class="main" tabindex="-1">
<%= content %>
  </main>
</div>
<footer class="footer">
  <%- if site -%>
  <p>Index written <time datetime="<%= h.esc(status['generated_at']) %>"><%= h.time(status['generated_at']) %></time>. Last successful run <%= status['last_success'] ? h.time(status['last_success']) : 'not yet' %>. Generated by seamstress <%= Seamstress::VERSION %> from <%= status['source'] == 'git' ? 'the control repo' : 'deployed code' %>.</p>
  <%- else -%>
  <%- prov = manifest['provenance'] || {} -%>
  <p>Built <time datetime="<%= h.esc(manifest['built_at']) %>"><%= h.time(manifest['built_at']) %></time><%= prov['commit'] ? " from commit #{h.esc(h.short(prov['commit']))}" : '' %> with puppet-strings <%= h.esc(manifest.dig('generator', 'puppet_strings')) %> and seamstress <%= Seamstress::VERSION %>.</p>
  <%- end -%>
</footer>
<div class="palette" data-palette hidden>
  <div class="palette-scrim" data-palette-close></div>
  <div class="palette-box" role="dialog" aria-modal="true" aria-label="Search">
    <div class="palette-field">
      <input class="palette-input" type="text" autocomplete="off" spellcheck="false" data-palette-input
             role="combobox" aria-expanded="true" aria-controls="palette-results" aria-autocomplete="list"
             placeholder="Search classes, types, functions, parameters" aria-label="Search">
      <kbd class="palette-esc">Esc</kbd>
    </div>
    <p class="palette-status" data-palette-status aria-live="polite"></p>
    <div class="palette-results" id="palette-results" role="listbox" data-palette-results></div>
  </div>
</div>
</body>
</html>
