<%-
  env_name = site ? nil : manifest['environment']
  search_base = site ? (search_env ? "environments/#{search_env}/" : '') : env_root
  search_name = site ? search_env : env_name
  built = site ? '' : manifest['built_at']
-%>
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="seamstress <%= Seamstress::VERSION %>">
<meta name="color-scheme" content="light dark">
<title><%= h.esc([title, env_name, config['site_title']].compact.uniq.join(' | ')) %></title>
<link rel="stylesheet" href="<%= root %>assets/site.css">
<script src="<%= root %>assets/site.js"></script>
<%- if name == 'hiera' -%>
<script src="<%= root %>assets/hiera.js"></script>
<%- end -%>
</head>
<body data-page="<%= name %>" data-root="<%= root %>"<%- if env_name -%> data-env="<%= h.esc(env_name) %>" data-built="<%= h.esc(built) %>"<%- end -%><%- if search_name -%> data-search-base="<%= h.esc(search_base) %>" data-search-env="<%= h.esc(search_name) %>"<%- end -%>>
<a class="skip" href="#main">Skip to content</a>
<header class="topbar">
  <%- unless site -%>
  <button class="menu-toggle" type="button" data-menu-toggle aria-controls="sidebar" aria-expanded="false">Contents</button>
  <%- end -%>
  <a class="brand" href="<%= root %>index.html"><%= h.esc(config['site_title']) %></a>
  <%- if env_name -%>
  <a class="env-pill" href="<%= env_root %>index.html" title="Environment dashboard"><%= h.esc(env_name) %></a>
  <%- end -%>
  <%- if search_name -%>
  <button class="search-trigger" type="button" data-palette-open aria-haspopup="dialog">
    <span>Search<span class="search-scope"> <%= h.esc(search_name) %></span></span><kbd>/</kbd>
  </button>
  <%- end -%>
  <a class="topbar-link" href="<%= root %>compare.html">Compare</a>
  <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch colour theme">Theme: auto</button>
</header>
<div class="banner" data-stale-banner role="status" hidden></div>
<div class="frame<%= site ? ' frame-site' : '' %>">
  <%- unless site -%>
  <%= h.page('sidebar', env: env, manifest: manifest, mod: mod, obj: obj, depth: depth, env_root: env_root, root: root, name: name) %>
  <%- end -%>
  <main id="main" class="main" tabindex="-1">
<%= content %>
  </main>
</div>
<footer class="footer">
  <%- if site -%>
  <p>Index written <time datetime="<%= h.esc(status['generated_at']) %>"><%= h.time(status['generated_at']) %></time>. Last successful run <%= status['last_success'] ? h.time(status['last_success']) : 'not yet' %>. Generated by seamstress <%= Seamstress::VERSION %> from <%= status['source'] == 'git' ? 'the control repo' : 'deployed code' %>.</p>
  <%- else -%>
  <%- prov = manifest['provenance'] || {} -%>
  <p>Built <time datetime="<%= h.esc(manifest['built_at']) %>"><%= h.time(manifest['built_at']) %></time><%= prov['commit'] ? " from commit #{h.esc(h.short(prov['commit']))}" : '' %> with puppet-strings <%= h.esc(manifest.dig('generator', 'puppet_strings')) %> and seamstress <%= Seamstress::VERSION %>.</p>
  <%- end -%>
</footer>
<div class="palette" data-palette hidden>
  <div class="palette-scrim" data-palette-close></div>
  <div class="palette-box" role="dialog" aria-modal="true" aria-label="Search">
    <div class="palette-field">
      <input class="palette-input" type="text" autocomplete="off" spellcheck="false" data-palette-input
             role="combobox" aria-expanded="true" aria-controls="palette-results" aria-autocomplete="list"
             placeholder="Search classes, types, functions, parameters" aria-label="Search">
      <kbd class="palette-esc">Esc</kbd>
    </div>
    <p class="palette-status" data-palette-status aria-live="polite"></p>
    <div class="palette-results" id="palette-results" role="listbox" data-palette-results></div>
  </div>
</div>
</body>
</html>
