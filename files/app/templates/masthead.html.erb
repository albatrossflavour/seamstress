<header class="masthead">
  <a class="masthead-title" href="<%= root %>index.html"><%= h.esc(config['site_title']) %></a>
  <%- if defined?(crumb) && crumb -%>
  <span class="masthead-crumb"><%= h.esc(crumb) %></span>
  <%- end -%>
  <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch colour theme">Theme: auto</button>
</header>
