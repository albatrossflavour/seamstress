<section class="finder" data-search data-search-root="<%= search_root %>" aria-label="Search">
  <label class="finder-label" for="finder-input">Find a class, defined type, function, task, or plan</label>
  <div class="finder-row">
    <%- if envs && envs.size > 1 -%>
    <select class="finder-env" data-search-env aria-label="Environment to search">
      <%- envs.each do |name| -%>
      <option value="<%= h.esc(name) %>"><%= h.esc(name) %></option>
      <%- end -%>
    </select>
    <%- end -%>
    <input id="finder-input" class="finder-input" type="search" autocomplete="off" spellcheck="false"
           placeholder="apache::vhost, stdlib, to_json&hellip;" data-search-input
           <%= envs && envs.size == 1 ? %(data-search-fixed="#{h.esc(envs.first)}") : '' %>>
  </div>
  <div class="finder-kinds" role="group" aria-label="Filter by kind" data-search-kinds>
    <button type="button" aria-pressed="true" data-kind="">Everything</button>
    <button type="button" aria-pressed="false" data-kind="class">Classes</button>
    <button type="button" aria-pressed="false" data-kind="defined type">Defined types</button>
    <button type="button" aria-pressed="false" data-kind="resource type">Resource types</button>
    <button type="button" aria-pressed="false" data-kind="function">Functions</button>
    <button type="button" aria-pressed="false" data-kind="task">Tasks</button>
    <button type="button" aria-pressed="false" data-kind="plan">Plans</button>
  </div>
  <p class="finder-status" data-search-status aria-live="polite"></p>
  <ol class="finder-results" data-search-results></ol>
</section>
