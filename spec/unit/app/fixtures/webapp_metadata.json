{
  "name": "example-webapp",
  "version": "0.3.0",
  "author": "example",
  "summary": "Runs the example web application.",
  "license": "Apache-2.0",
  "source": "https://git.example.com/puppet/webapp",
  "dependencies": [
    { "name": "puppetlabs/stdlib", "version_requirement": ">= 9.0.0 < 10.0.0" },
    { "name": "puppet/systemd", "version_requirement": ">= 8.0.0 < 9.0.0" },
    { "name": "puppetlabs/concat", "version_requirement": ">= 7.0.0" }
  ],
  "operatingsystem_support": [
    { "operatingsystem": "RedHat", "operatingsystemrelease": ["9"] },
    { "operatingsystem": "Ubuntu", "operatingsystemrelease": ["22.04", "24.04"] }
  ]
