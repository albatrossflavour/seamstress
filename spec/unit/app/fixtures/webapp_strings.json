{
  "puppet_classes": [
    {
      "name": "webapp",
      "file": "manifests/init.pp",
      "line": 21,
      "docstring": {
        "text": "Pulls in `profile::base` and one `webapp::vhost` per site. Ports are\nchecked against `Webapp::Port`.\n\n<script>alert(\"desc\")</script><img src=x onerror=alert(2)> [bad](javascript:alert(3)) [good](https://example.com/a?b=1&c=2)",
        "tags": [
          {
            "tag_name": "example",
            "text": "class { 'webapp':\n  port => 8080,\n}",
            "name": "Basic use"
          },
          {
            "tag_name": "param",
            "text": "Port the application listens on.",
            "types": [
              "Webapp::Port"
            ],
            "name": "port"
          },
          {
            "tag_name": "param",
            "text": "Worker processes. <b onmouseover=\"alert(1)\">bold</b>",
            "types": [
              "Integer[1, 64]"
            ],
            "name": "workers"
          },
          {
            "tag_name": "param",
            "text": "Virtual hosts to create, keyed by name.",
            "types": [
              "Hash[String[1], Hash]"
            ],
            "name": "sites"
          },
          {
            "tag_name": "param",
            "types": [
              "Stdlib::Absolutepath"
            ],
            "name": "log_dir"
          },
          {
            "tag_name": "param",
            "text": "Whether the application is present.",
            "types": [
              "Enum['present', 'absent']"
            ],
            "name": "ensure"
          },
          {
            "tag_name": "summary",
            "text": "Installs and runs the example web application."
          },
          {
            "tag_name": "option",
            "name": "sites",
            "opt_name": "docroot",
            "opt_text": "Per-site docroot.",
            "opt_types": [
              "Stdlib::Absolutepath"
            ]
          },
          {
            "tag_name": "see",
            "name": "webapp::vhost",
            "text": "for one site"
          }
        ]
      },
      "defaults": {
        "port": "8080",
        "workers": "2",
        "sites": "{}",
        "log_dir": "'/var/log/webapp'",
        "ensure": "'present'"
      },
      "source": "class webapp (\n  Webapp::Port $port = 8080,\n  Integer[1, 64] $workers = 2,\n  Hash[String[1], Hash] $sites = {},\n  Stdlib::Absolutepath $log_dir = '/var/log/webapp',\n  Enum['present', 'absent'] $ensure = 'present',\n) {\n  include profile::base\n  contain webapp::config\n  $sites.each |$name, $opts| {\n    webapp::vhost { $name:\n      * => $opts,\n    }\n  }\n}"
    },
    {
