          {
            "tag_name": "summary",
            "text": "Turns any string into a safe slug."
          }
        ]
      },
      "source": "Puppet::Functions.create_function(:'webapp::slug') do\n  # @param text The text to slugify.\n  # @return [String] Lower case, hyphenated.\n  # @example\n  #   webapp::slug('Hello World') # => 'hello-world'\n  dispatch :slug do\n    param 'String', :text\n    return_type 'String'\n  end\n\n  # @param text Several strings.\n  # @return [Array[String]] One slug each.\n  dispatch :slugs do\n    param 'Array[String]', :text\n    return_type 'Array[String]'\n  end\n\n  def slug(text)\n    text.downcase.gsub(/[^a-z0-9]+/, '-')\n  end\n\n  def slugs(text)\n    text.map { |t| slug(t) }\n  end\nend"
    },
